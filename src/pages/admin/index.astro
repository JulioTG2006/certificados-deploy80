---
import AdminLayout from "../../layouts/AdminLayout.astro";
import Card from "../../components/ui/Card.astro";
---

<AdminLayout title="Panel Administrador">

  <div class="mb-10">
    <h1 id="panelTitle" class="text-4xl font-bold text-slate-800">
      Panel Administrativo
    </h1>

    <p class="text-gray-500 mt-2">
      Control general del sistema.
    </p>
  </div>

  <div class="grid md:grid-cols-4 gap-6 mb-10">
    <div class="solo-admin">
      <Card title="Usuarios" value="240" />
    </div>
    <Card title="Solicitudes" value="128" />
    <Card title="Certificados" value="54" />
    <Card title="Pendientes" value="17" />
  </div>

  <div class="bg-white rounded-3xl shadow-md p-8">
    <h2 class="text-2xl font-bold mb-6">
      Actividad reciente
    </h2>

    <div class="space-y-4">

      <div class="border-b pb-4">
        Nuevo usuario registrado
      </div>

      <div class="border-b pb-4">
        Solicitud aprobada
      </div>

      <div>
        Nuevo certificado generado
      </div>

    </div>
  </div>

  <script>
    const userData = localStorage.getItem("user");

    if (!userData) {
      window.location.replace("/login");
    } else {
      const user = JSON.parse(userData);

      // 1. Permitimos el acceso solo si es Admin (2) o Revisor (3). Si es Alumno (1), lo mandamos al dashboard.
      if (user.rol_id !== 2 && user.rol_id !== 3) {
        window.location.replace("/dashboard");
      }

      // 2. Si es Revisor (rol_id === 3), personalizamos la interfaz de usuario
      if (user.rol_id === 3) {
        // Cambiamos el texto del título principal
        const titulo = document.getElementById("panelTitle");
        if (titulo) {
          titulo.textContent = "Panel Revisor";
        }

        // Limpiamos la pantalla borrando los elementos con la clase 'solo-admin'
        const elementosRestringidos = document.querySelectorAll('.solo-admin');
        elementosRestringidos.forEach(elemento => {
          elemento.remove(); // Desaparece la tarjeta de usuarios por completo
        });
      }
    }
  </script>
</AdminLayout>